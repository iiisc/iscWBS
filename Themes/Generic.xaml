<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--
        Colours are keyed separately from their brushes so controls that draw in code (the WBS diagram,
        the Gantt chart) can declare proxy brushes with {ThemeResource ...Color} that follow the theme.
    -->
    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
            <Color x:Key="WbsStatusNotStartedColor">#808080</Color>
            <Color x:Key="WbsStatusInProgressColor">#0078D4</Color>
            <Color x:Key="WbsStatusCompleteColor">#107C10</Color>
            <Color x:Key="WbsStatusBlockedColor">#C50F1F</Color>
            <SolidColorBrush x:Key="WbsStatusNotStartedBrush" Color="{StaticResource WbsStatusNotStartedColor}" />
            <SolidColorBrush x:Key="WbsStatusInProgressBrush" Color="{StaticResource WbsStatusInProgressColor}" />
            <SolidColorBrush x:Key="WbsStatusCompleteBrush"   Color="{StaticResource WbsStatusCompleteColor}" />
            <SolidColorBrush x:Key="WbsStatusBlockedBrush"    Color="{StaticResource WbsStatusBlockedColor}" />
            <Color x:Key="GanttLabelForegroundColor">#FF000000</Color>
            <Color x:Key="GanttHeaderBackgroundColor">#14000000</Color>
            <Color x:Key="GanttHeaderBottomBackgroundColor">#0A000000</Color>
            <Color x:Key="GanttRowBandColor">#0A000000</Color>
            <!-- Solid backgrounds prevent content bleed-through in the acrylic dropdowns -->
            <SolidColorBrush x:Key="ComboBoxDropDownBackground"     Color="#F3F3F3" />
            <SolidColorBrush x:Key="MenuFlyoutPresenterBackground"  Color="#F3F3F3" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
            <Color x:Key="WbsStatusNotStartedColor">#9E9E9E</Color>
            <Color x:Key="WbsStatusInProgressColor">#60CDFF</Color>
            <Color x:Key="WbsStatusCompleteColor">#6CCB5F</Color>
            <Color x:Key="WbsStatusBlockedColor">#FF99A4</Color>
            <SolidColorBrush x:Key="WbsStatusNotStartedBrush" Color="{StaticResource WbsStatusNotStartedColor}" />
            <SolidColorBrush x:Key="WbsStatusInProgressBrush" Color="{StaticResource WbsStatusInProgressColor}" />
            <SolidColorBrush x:Key="WbsStatusCompleteBrush"   Color="{StaticResource WbsStatusCompleteColor}" />
            <SolidColorBrush x:Key="WbsStatusBlockedBrush"    Color="{StaticResource WbsStatusBlockedColor}" />
            <Color x:Key="GanttLabelForegroundColor">#FFFFFFFF</Color>
            <Color x:Key="GanttHeaderBackgroundColor">#28FFFFFF</Color>
            <Color x:Key="GanttHeaderBottomBackgroundColor">#14FFFFFF</Color>
            <Color x:Key="GanttRowBandColor">#0FFFFFFF</Color>
            <SolidColorBrush x:Key="ComboBoxDropDownBackground"     Color="#202020" />
            <SolidColorBrush x:Key="MenuFlyoutPresenterBackground"  Color="#202020" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="HighContrast">
            <StaticResource x:Key="WbsStatusNotStartedColor" ResourceKey="SystemColorWindowTextColor" />
            <StaticResource x:Key="WbsStatusInProgressColor" ResourceKey="SystemColorHighlightColor" />
            <StaticResource x:Key="WbsStatusCompleteColor"   ResourceKey="SystemColorWindowTextColor" />
            <StaticResource x:Key="WbsStatusBlockedColor"    ResourceKey="SystemColorHighlightTextColor" />
            <SolidColorBrush x:Key="WbsStatusNotStartedBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="WbsStatusInProgressBrush" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="WbsStatusCompleteBrush"   Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="WbsStatusBlockedBrush"    Color="{ThemeResource SystemColorHighlightTextColor}" />
            <StaticResource x:Key="GanttLabelForegroundColor"        ResourceKey="SystemColorWindowTextColor" />
            <StaticResource x:Key="GanttHeaderBackgroundColor"       ResourceKey="SystemColorWindowColor" />
            <StaticResource x:Key="GanttHeaderBottomBackgroundColor" ResourceKey="SystemColorWindowColor" />
            <StaticResource x:Key="GanttRowBandColor"                ResourceKey="SystemColorWindowColor" />
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>
</ResourceDictionary>
