<?xml version="1.0" encoding="utf-8"?>
<!-- iscWBS brand resources. Merge into App.xaml MergedDictionaries (after XamlControlsResources). -->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
            <Color x:Key="IscBackgroundColor">#F6F4FD</Color>
            <Color x:Key="IscSurfaceColor">#FFFFFF</Color>
            <Color x:Key="IscBorderColor">#DDD8F2</Color>
            <Color x:Key="IscTextColor">#1E1838</Color>
            <Color x:Key="IscTextMutedColor">#5A4F96</Color>
            <Color x:Key="IscConnectorColor">#7465C9</Color>
            <Color x:Key="IscAccentColor">#FFC928</Color>
            <Color x:Key="IscOnAccentColor">#14112B</Color>
            <Color x:Key="IscLevel1Color">#FFC928</Color>
            <Color x:Key="IscLevel2Color">#FF5C7F</Color>
            <Color x:Key="IscLevel3Color">#22D3A6</Color>
            <Color x:Key="IscLevel4Color">#2FA8F5</Color>
            <Color x:Key="IscLevel5Color">#B565F5</Color>
            <Color x:Key="IscLevel6Color">#8FD12E</Color>
            <SolidColorBrush x:Key="IscBackgroundBrush" Color="{ThemeResource IscBackgroundColor}" />
            <SolidColorBrush x:Key="IscSurfaceBrush" Color="{ThemeResource IscSurfaceColor}" />
            <SolidColorBrush x:Key="IscBorderBrush" Color="{ThemeResource IscBorderColor}" />
            <SolidColorBrush x:Key="IscTextBrush" Color="{ThemeResource IscTextColor}" />
            <SolidColorBrush x:Key="IscTextMutedBrush" Color="{ThemeResource IscTextMutedColor}" />
            <SolidColorBrush x:Key="IscConnectorBrush" Color="{ThemeResource IscConnectorColor}" />
            <SolidColorBrush x:Key="IscAccentBrush" Color="{ThemeResource IscAccentColor}" />
            <SolidColorBrush x:Key="IscOnAccentBrush" Color="{ThemeResource IscOnAccentColor}" />
            <SolidColorBrush x:Key="IscLevel1Brush" Color="{ThemeResource IscLevel1Color}" />
            <SolidColorBrush x:Key="IscLevel2Brush" Color="{ThemeResource IscLevel2Color}" />
            <SolidColorBrush x:Key="IscLevel3Brush" Color="{ThemeResource IscLevel3Color}" />
            <SolidColorBrush x:Key="IscLevel4Brush" Color="{ThemeResource IscLevel4Color}" />
            <SolidColorBrush x:Key="IscLevel5Brush" Color="{ThemeResource IscLevel5Color}" />
            <SolidColorBrush x:Key="IscLevel6Brush" Color="{ThemeResource IscLevel6Color}" />
            <!-- WinUI's cards, popups and the window's content area in the brand surfaces. Popups are solid so the
                 content behind an acrylic dropdown doesn't bleed through. -->
            <SolidColorBrush x:Key="CardBackgroundFillColorDefaultBrush" Color="{ThemeResource IscSurfaceColor}" />
            <SolidColorBrush x:Key="CardStrokeColorDefaultBrush" Color="{ThemeResource IscBorderColor}" />
            <SolidColorBrush x:Key="NavigationViewContentBackground" Color="{ThemeResource IscBackgroundColor}" />
            <SolidColorBrush x:Key="NavigationViewContentGridBorderBrush" Color="{ThemeResource IscBorderColor}" />
            <SolidColorBrush x:Key="NavigationViewExpandedPaneBackground" Color="{ThemeResource IscSurfaceColor}" />
            <SolidColorBrush x:Key="MenuFlyoutPresenterBackground" Color="{ThemeResource IscSurfaceColor}" />
            <SolidColorBrush x:Key="ComboBoxDropDownBackground" Color="{ThemeResource IscSurfaceColor}" />
            <SolidColorBrush x:Key="FlyoutPresenterBackground" Color="{ThemeResource IscSurfaceColor}" />
            <SolidColorBrush x:Key="ContentDialogBackground" Color="{ThemeResource IscSurfaceColor}" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
            <!-- Near-neutral rather than the kit's purple night, so the brand colours stand out instead of tinting everything -->
            <Color x:Key="IscBackgroundColor">#131316</Color>
            <Color x:Key="IscSurfaceColor">#1E1E23</Color>
            <Color x:Key="IscBorderColor">#303038</Color>
            <Color x:Key="IscTextColor">#FFFFFF</Color>
            <Color x:Key="IscTextMutedColor">#C4B8FF</Color>
            <Color x:Key="IscConnectorColor">#8A7FD6</Color>
            <Color x:Key="IscAccentColor">#FFE14D</Color>
            <Color x:Key="IscOnAccentColor">#14112B</Color>
            <Color x:Key="IscLevel1Color">#FFE14D</Color>
            <Color x:Key="IscLevel2Color">#FF6B8B</Color>
            <Color x:Key="IscLevel3Color">#3DF5C4</Color>
            <Color x:Key="IscLevel4Color">#4DC3FF</Color>
            <Color x:Key="IscLevel5Color">#C77DFF</Color>
            <Color x:Key="IscLevel6Color">#B8F35A</Color>
            <SolidColorBrush x:Key="IscBackgroundBrush" Color="{ThemeResource IscBackgroundColor}" />
            <SolidColorBrush x:Key="IscSurfaceBrush" Color="{ThemeResource IscSurfaceColor}" />
            <SolidColorBrush x:Key="IscBorderBrush" Color="{ThemeResource IscBorderColor}" />
            <SolidColorBrush x:Key="IscTextBrush" Color="{ThemeResource IscTextColor}" />
            <SolidColorBrush x:Key="IscTextMutedBrush" Color="{ThemeResource IscTextMutedColor}" />
            <SolidColorBrush x:Key="IscConnectorBrush" Color="{ThemeResource IscConnectorColor}" />
            <SolidColorBrush x:Key="IscAccentBrush" Color="{ThemeResource IscAccentColor}" />
            <SolidColorBrush x:Key="IscOnAccentBrush" Color="{ThemeResource IscOnAccentColor}" />
            <SolidColorBrush x:Key="IscLevel1Brush" Color="{ThemeResource IscLevel1Color}" />
            <SolidColorBrush x:Key="IscLevel2Brush" Color="{ThemeResource IscLevel2Color}" />
            <SolidColorBrush x:Key="IscLevel3Brush" Color="{ThemeResource IscLevel3Color}" />
            <SolidColorBrush x:Key="IscLevel4Brush" Color="{ThemeResource IscLevel4Color}" />
            <SolidColorBrush x:Key="IscLevel5Brush" Color="{ThemeResource IscLevel5Color}" />
            <SolidColorBrush x:Key="IscLevel6Brush" Color="{ThemeResource IscLevel6Color}" />
            <SolidColorBrush x:Key="CardBackgroundFillColorDefaultBrush" Color="{ThemeResource IscSurfaceColor}" />
            <SolidColorBrush x:Key="CardStrokeColorDefaultBrush" Color="{ThemeResource IscBorderColor}" />
            <SolidColorBrush x:Key="NavigationViewContentBackground" Color="{ThemeResource IscBackgroundColor}" />
            <SolidColorBrush x:Key="NavigationViewContentGridBorderBrush" Color="{ThemeResource IscBorderColor}" />
            <SolidColorBrush x:Key="NavigationViewExpandedPaneBackground" Color="{ThemeResource IscSurfaceColor}" />
            <SolidColorBrush x:Key="MenuFlyoutPresenterBackground" Color="{ThemeResource IscSurfaceColor}" />
            <SolidColorBrush x:Key="ComboBoxDropDownBackground" Color="{ThemeResource IscSurfaceColor}" />
            <SolidColorBrush x:Key="FlyoutPresenterBackground" Color="{ThemeResource IscSurfaceColor}" />
            <SolidColorBrush x:Key="ContentDialogBackground" Color="{ThemeResource IscSurfaceColor}" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="HighContrast">
            <StaticResource x:Key="IscBackgroundColor" ResourceKey="SystemColorWindowColor" />
            <StaticResource x:Key="IscSurfaceColor" ResourceKey="SystemColorWindowColor" />
            <StaticResource x:Key="IscBorderColor" ResourceKey="SystemColorWindowTextColor" />
            <StaticResource x:Key="IscTextColor" ResourceKey="SystemColorWindowTextColor" />
            <StaticResource x:Key="IscTextMutedColor" ResourceKey="SystemColorWindowTextColor" />
            <StaticResource x:Key="IscConnectorColor" ResourceKey="SystemColorWindowTextColor" />
            <StaticResource x:Key="IscAccentColor" ResourceKey="SystemColorHighlightColor" />
            <StaticResource x:Key="IscOnAccentColor" ResourceKey="SystemColorHighlightTextColor" />
            <StaticResource x:Key="IscLevel1Color" ResourceKey="SystemColorWindowTextColor" />
            <StaticResource x:Key="IscLevel2Color" ResourceKey="SystemColorWindowTextColor" />
            <StaticResource x:Key="IscLevel3Color" ResourceKey="SystemColorWindowTextColor" />
            <StaticResource x:Key="IscLevel4Color" ResourceKey="SystemColorWindowTextColor" />
            <StaticResource x:Key="IscLevel5Color" ResourceKey="SystemColorWindowTextColor" />
            <StaticResource x:Key="IscLevel6Color" ResourceKey="SystemColorWindowTextColor" />
            <SolidColorBrush x:Key="IscBackgroundBrush" Color="{ThemeResource IscBackgroundColor}" />
            <SolidColorBrush x:Key="IscSurfaceBrush" Color="{ThemeResource IscSurfaceColor}" />
            <SolidColorBrush x:Key="IscBorderBrush" Color="{ThemeResource IscBorderColor}" />
            <SolidColorBrush x:Key="IscTextBrush" Color="{ThemeResource IscTextColor}" />
            <SolidColorBrush x:Key="IscTextMutedBrush" Color="{ThemeResource IscTextMutedColor}" />
            <SolidColorBrush x:Key="IscConnectorBrush" Color="{ThemeResource IscConnectorColor}" />
            <SolidColorBrush x:Key="IscAccentBrush" Color="{ThemeResource IscAccentColor}" />
            <SolidColorBrush x:Key="IscOnAccentBrush" Color="{ThemeResource IscOnAccentColor}" />
            <SolidColorBrush x:Key="IscLevel1Brush" Color="{ThemeResource IscLevel1Color}" />
            <SolidColorBrush x:Key="IscLevel2Brush" Color="{ThemeResource IscLevel2Color}" />
            <SolidColorBrush x:Key="IscLevel3Brush" Color="{ThemeResource IscLevel3Color}" />
            <SolidColorBrush x:Key="IscLevel4Brush" Color="{ThemeResource IscLevel4Color}" />
            <SolidColorBrush x:Key="IscLevel5Brush" Color="{ThemeResource IscLevel5Color}" />
            <SolidColorBrush x:Key="IscLevel6Brush" Color="{ThemeResource IscLevel6Color}" />
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>

    <!-- Theme-independent brand colors (app icon, splash, title bar accents) -->
    <Color x:Key="IscNightColor">#14112B</Color>
    <SolidColorBrush x:Key="IscNightBrush" Color="#14112B" />

    <!-- Typography: Outfit. The variable font carries all weights; use FontWeight Light/Normal/SemiBold.
         The kit's static weights aren't shipped: every weight renders from the variable font in the AOT build. -->
    <FontFamily x:Key="IscFontFamily">ms-appx:///Assets/Fonts/Outfit-Variable.ttf#Outfit</FontFamily>

    <!-- Shape -->
    <CornerRadius x:Key="IscCornerRadiusSmall">8</CornerRadius>
    <CornerRadius x:Key="IscCornerRadiusMedium">14</CornerRadius>
    <CornerRadius x:Key="IscCornerRadiusLarge">20</CornerRadius>
    <!-- Tree nodes are squircles: corner radius ~31% of node height. 11 suits a 36px node. -->
    <CornerRadius x:Key="IscNodeCornerRadius">11</CornerRadius>
    <x:Double x:Key="IscConnectorThickness">2</x:Double>

    <!-- WinUI's accent (buttons, toggles, progress, selection) in the brand's connector purple. Light theme fills use
         Dark1 under white text, Dark theme fills Light2 under black text; both read at 6:1 or better. -->
    <Color x:Key="SystemAccentColor">#7465C9</Color>
    <Color x:Key="SystemAccentColorLight1">#8A7FD6</Color>
    <Color x:Key="SystemAccentColorLight2">#A89EDB</Color>
    <Color x:Key="SystemAccentColorLight3">#C4B8FF</Color>
    <Color x:Key="SystemAccentColorDark1">#5F51B3</Color>
    <Color x:Key="SystemAccentColorDark2">#4A3E96</Color>
    <Color x:Key="SystemAccentColorDark3">#352B73</Color>

    <Style x:Key="IscPageTitleTextBlockStyle" TargetType="TextBlock" BasedOn="{StaticResource TitleTextBlockStyle}">
        <Setter Property="FontFamily" Value="{StaticResource IscFontFamily}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style x:Key="IscSectionTitleTextBlockStyle" TargetType="TextBlock" BasedOn="{StaticResource SubtitleTextBlockStyle}">
        <Setter Property="FontFamily" Value="{StaticResource IscFontFamily}" />
    </Style>

    <!-- The BETA tag next to a page title or navigation item -->
    <Style x:Key="IscBadgeBorderStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource IscAccentBrush}" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="Padding" Value="6,1" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style x:Key="IscBadgeTextBlockStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{ThemeResource IscOnAccentBrush}" />
        <Setter Property="FontSize" Value="10" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
</ResourceDictionary>
