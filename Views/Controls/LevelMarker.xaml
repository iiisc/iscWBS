<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="iscWBS.Views.Controls.LevelMarker"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    IsTabStop="False"
    AutomationProperties.AccessibilityView="Raw">

    <!-- Brushes declared on an element follow theme changes; app-level ones keep the colour they started with. -->
    <UserControl.Resources>
        <SolidColorBrush x:Key="Level1" Color="{ThemeResource IscLevel1Color}" />
        <SolidColorBrush x:Key="Level2" Color="{ThemeResource IscLevel2Color}" />
        <SolidColorBrush x:Key="Level3" Color="{ThemeResource IscLevel3Color}" />
        <SolidColorBrush x:Key="Level4" Color="{ThemeResource IscLevel4Color}" />
        <SolidColorBrush x:Key="Level5" Color="{ThemeResource IscLevel5Color}" />
        <SolidColorBrush x:Key="Level6" Color="{ThemeResource IscLevel6Color}" />
    </UserControl.Resources>

    <Border x:Name="Marker" />
</UserControl>
