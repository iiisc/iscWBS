<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="iscWBS.Views.Controls.NewProjectControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <StackPanel Spacing="12" MinWidth="380" Padding="0,4,0,4">

        <TextBox
            x:Uid="NewProject_TxtName"
            x:Name="TxtName"
            Header="Project Name *"
            PlaceholderText="Enter project name"
            AutomationProperties.Name="Project name" />

        <TextBox
            x:Uid="NewProject_TxtOwner"
            x:Name="TxtOwner"
            Header="Owner"
            PlaceholderText="Enter owner name"
            AutomationProperties.Name="Project owner" />

        <StackPanel Spacing="4">
            <TextBlock
                x:Uid="NewProject_StartFrom"
                Text="Start From"
                Style="{ThemeResource CaptionTextBlockStyle}" />
            <TextBlock
                x:Name="TxtSource"
                Style="{ThemeResource BodyTextBlockStyle}"
                TextWrapping="Wrap" />
            <TextBlock
                x:Uid="NewProject_SourceHint"
                Text="Copy another project's plan, with progress cleared and dates moved to start today, or import a workbook exported from iscWBS."
                Style="{ThemeResource CaptionTextBlockStyle}"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                TextWrapping="Wrap" />
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button
                    x:Uid="NewProject_BtnPickSource"
                    Content="Choose File..."
                    AutomationProperties.Name="Choose a project or workbook to start from"
                    Click="BtnPickSource_Click" />
                <Button
                    x:Name="BtnClearSource"
                    x:Uid="NewProject_BtnClearSource"
                    Content="Start Empty"
                    Visibility="Collapsed"
                    Click="BtnClearSource_Click" />
            </StackPanel>
        </StackPanel>

        <StackPanel Spacing="4">
            <TextBlock
                x:Uid="NewProject_SaveLocation"
                Text="Save Location *"
                Style="{ThemeResource CaptionTextBlockStyle}" />
            <TextBlock
                x:Uid="NewProject_TxtSavePath"
                x:Name="TxtSavePath"
                Text="No folder selected"
                Style="{ThemeResource BodyTextBlockStyle}"
                TextWrapping="Wrap" />
            <Button
                x:Uid="NewProject_BtnPickFolder"
                x:Name="BtnPickFolder"
                Content="Choose Folder..."
                AutomationProperties.Name="Choose save folder"
                Click="BtnPickFolder_Click" />
        </StackPanel>

    </StackPanel>
</UserControl>
