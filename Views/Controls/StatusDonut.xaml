<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="iscWBS.Views.Controls.StatusDonut"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Brushes declared on an element follow theme changes; app-level ones keep the colour they started with. -->
    <UserControl.Resources>
        <SolidColorBrush x:Key="NotStarted" Color="{ThemeResource WbsStatusNotStartedColor}" />
        <SolidColorBrush x:Key="InProgress" Color="{ThemeResource WbsStatusInProgressColor}" />
        <SolidColorBrush x:Key="Complete"   Color="{ThemeResource WbsStatusCompleteColor}" />
        <SolidColorBrush x:Key="Blocked"    Color="{ThemeResource WbsStatusBlockedColor}" />
    </UserControl.Resources>

    <Canvas x:Name="Chart" />
</UserControl>
