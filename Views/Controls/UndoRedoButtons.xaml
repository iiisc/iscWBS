<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="iscWBS.Views.Controls.UndoRedoButtons"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <StackPanel Orientation="Horizontal" Spacing="4">
        <Button
            x:Uid="UndoRedo_Undo"
            Command="{x:Bind Undo.UndoCommand}"
            ToolTipService.ToolTip="Undo (Ctrl+Z)"
            AutomationProperties.Name="Undo">
            <FontIcon Glyph="&#xE7A7;" FontSize="16" />
        </Button>
        <Button
            x:Uid="UndoRedo_Redo"
            Command="{x:Bind Undo.RedoCommand}"
            ToolTipService.ToolTip="Redo (Ctrl+Y)"
            AutomationProperties.Name="Redo">
            <FontIcon Glyph="&#xE7A6;" FontSize="16" />
        </Button>
    </StackPanel>
</UserControl>
