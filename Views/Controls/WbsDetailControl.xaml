<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="iscWBS.Views.Controls.WbsDetailControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:iscWBS.ViewModels"
    xmlns:models="using:iscWBS.Core.Models"
    xmlns:local="using:iscWBS.Views.Controls">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="12" Padding="16">

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock
                    Grid.Column="0"
                    x:Uid="WbsDetail_Title"
                    Text="Node Details"
                    Style="{StaticResource IscSectionTitleTextBlockStyle}"
                    VerticalAlignment="Center" />
                <Button
                    x:Uid="WbsDetail_CloseDetailPanel"
                    Grid.Column="2"
                    Content="&#xE711;"
                    FontFamily="{ThemeResource SymbolThemeFontFamily}"
                    FontSize="12"
                    Padding="4"
                    Command="{x:Bind ViewModel.ClearSelectionCommand}"
                    AutomationProperties.Name="Close detail panel">
                    <Button.KeyboardAccelerators>
                        <KeyboardAccelerator Key="Escape" />
                    </Button.KeyboardAccelerators>
                </Button>
            </Grid>

            <StackPanel Spacing="4">
                <TextBlock x:Uid="WbsDetail_CodeLabel" Text="Code" Style="{ThemeResource CaptionTextBlockStyle}" />
                <TextBlock
                    x:Uid="WbsDetail_NodeCode"
                    Text="{x:Bind ViewModel.SelectedNode.Code, Mode=OneWay}"
                    FontWeight="SemiBold"
                    AutomationProperties.Name="Node code" />
            </StackPanel>

            <StackPanel Spacing="4">
                <TextBlock x:Uid="WbsDetail_TitleLabel" Text="Title" Style="{ThemeResource CaptionTextBlockStyle}" />
                <TextBox
                    x:Uid="WbsDetail_TitleInput"
                    Text="{x:Bind ViewModel.EditTitle, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                    LostFocus="{x:Bind ViewModel.SaveIfDirty}"
                    PlaceholderText="Node title…"
                    AutomationProperties.Name="Title" />
            </StackPanel>

            <StackPanel Spacing="4">
                <TextBlock x:Uid="WbsDetail_DescriptionLabel" Text="Description" Style="{ThemeResource CaptionTextBlockStyle}" />
                <TextBox
                    x:Uid="WbsDetail_Description"
                    Text="{x:Bind ViewModel.EditDescription, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                    LostFocus="{x:Bind ViewModel.SaveIfDirty}"
                    AcceptsReturn="True"
                    Height="80"
                    TextWrapping="Wrap"
                    AutomationProperties.Name="Description" />
            </StackPanel>

            <StackPanel Spacing="4">
                <TextBlock x:Uid="WbsDetail_AssignedToLabel" Text="Assigned To" Style="{ThemeResource CaptionTextBlockStyle}" />
                <TextBox
                    x:Uid="WbsDetail_AssignedTo"
                    Text="{x:Bind ViewModel.EditAssignedTo, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                    LostFocus="{x:Bind ViewModel.SaveIfDirty}"
                    AutomationProperties.Name="Assigned to" />
            </StackPanel>

            <StackPanel Spacing="4">
                <TextBlock x:Uid="WbsDetail_StatusLabel" Text="Status" Style="{ThemeResource CaptionTextBlockStyle}" />
                <ComboBox
                    x:Uid="WbsDetail_Status"
                    ItemsSource="{x:Bind ViewModel.StatusOptions, Mode=OneWay}"
                    SelectedItem="{x:Bind ViewModel.EditStatus, Mode=TwoWay}"
                    HorizontalAlignment="Stretch"
                    AutomationProperties.Name="Status">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <local:StatusMarker Status="{Binding}" />
                                <TextBlock Text="{Binding Converter={StaticResource StatusToStringConverter}}" />
                            </StackPanel>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
            </StackPanel>

            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Spacing="4">
                    <TextBlock x:Uid="WbsDetail_EstHoursLabel" Text="Est. Hours" Style="{ThemeResource CaptionTextBlockStyle}" />
                    <NumberBox
                        x:Uid="WbsDetail_EstimatedHours"
                        Value="{x:Bind ViewModel.EditEstimatedHours, Mode=TwoWay}"
                        Minimum="0"
                        SpinButtonPlacementMode="Compact"
                        AutomationProperties.Name="Estimated hours" />
                </StackPanel>

                <StackPanel Grid.Column="1" Spacing="4">
                    <TextBlock x:Uid="WbsDetail_ActHoursLabel" Text="Act. Hours" Style="{ThemeResource CaptionTextBlockStyle}" />
                    <NumberBox
                        x:Uid="WbsDetail_ActualHours"
                        Value="{x:Bind ViewModel.EditActualHours, Mode=TwoWay}"
                        Minimum="0"
                        SpinButtonPlacementMode="Compact"
                        AutomationProperties.Name="Actual hours" />
                </StackPanel>
            </Grid>

            <StackPanel Spacing="4">
                <TextBlock x:Uid="WbsDetail_StartDateLabel" Text="Start Date" Style="{ThemeResource CaptionTextBlockStyle}" />
                <CalendarDatePicker
                    x:Uid="WbsDetail_StartDate"
                    Date="{x:Bind ViewModel.EditStartDate, Mode=TwoWay}"
                    HorizontalAlignment="Stretch"
                    AutomationProperties.Name="Start date" />
            </StackPanel>

            <StackPanel Spacing="4">
                <TextBlock x:Uid="WbsDetail_DueDateLabel" Text="Due Date" Style="{ThemeResource CaptionTextBlockStyle}" />
                <CalendarDatePicker
                    x:Uid="WbsDetail_DueDate"
                    Date="{x:Bind ViewModel.EditDueDate, Mode=TwoWay}"
                    HorizontalAlignment="Stretch"
                    AutomationProperties.Name="Due date" />
            </StackPanel>

            <ToggleSwitch
                x:Uid="WbsDetail_DeliverableToggle"
                IsOn="{x:Bind ViewModel.EditIsDeliverable, Mode=TwoWay}"
                Header="Include in report"
                OnContent="Deliverable"
                OffContent="Not a deliverable"
                AutomationProperties.Name="Mark node as a deliverable" />

            <Rectangle
                Height="1"
                Fill="{ThemeResource DividerStrokeColorDefaultBrush}"
                Margin="0,8,0,4" />

            <TextBlock
                x:Uid="WbsDetail_PredecessorsTitle"
                Text="Predecessors"
                Style="{StaticResource IscSectionTitleTextBlockStyle}" />

            <ItemsControl ItemsSource="{x:Bind ViewModel.NodeDependencies, Mode=OneWay}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:DependencyRowViewModel">
                            <Grid ColumnSpacing="8" Padding="0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="32" />
                                </Grid.ColumnDefinitions>
                                <TextBlock
                                    Grid.Column="0"
                                    Text="{x:Bind PredecessorCode}"
                                    FontWeight="SemiBold"
                                    VerticalAlignment="Center" />
                                <TextBlock
                                    Grid.Column="1"
                                    Text="{x:Bind PredecessorTitle}"
                                    TextTrimming="CharacterEllipsis"
                                    VerticalAlignment="Center" />
                                <TextBlock
                                    Grid.Column="2"
                                    Text="{x:Bind TypeLabel}"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    VerticalAlignment="Center">
                                    <ToolTipService.ToolTip>
                                        <ToolTip Content="{x:Bind TypeDescription}" />
                                    </ToolTipService.ToolTip>
                                </TextBlock>
                                <TextBlock
                                    Grid.Column="3"
                                    Text="&#xE7BA;"
                                    FontFamily="{ThemeResource SymbolThemeFontFamily}"
                                    FontSize="12"
                                    Foreground="{ThemeResource WbsStatusBlockedBrush}"
                                    VerticalAlignment="Center"
                                    Visibility="{x:Bind IsBlocking}">
                                    <ToolTipService.ToolTip>
                                        <ToolTip Content="{x:Bind BlockingReason}" />
                                    </ToolTipService.ToolTip>
                                </TextBlock>
                                <Button
                                    x:Uid="WbsDetail_RemoveDependency"
                                    Grid.Column="4"
                                    Content="&#xE74D;"
                                    FontFamily="{ThemeResource SymbolThemeFontFamily}"
                                    FontSize="12"
                                    Padding="4"
                                    Click="RemoveDependency_Click"
                                    AutomationProperties.Name="Remove dependency" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock
                    x:Uid="WbsDetail_AddPredecessorLabel"
                    Text="Add Predecessor"
                    Style="{ThemeResource CaptionTextBlockStyle}"
                    Margin="0,8,0,0" />

                <ComboBox
                    x:Uid="WbsDetail_PredecessorInput"
                    ItemsSource="{x:Bind ViewModel.PredecessorOptions, Mode=OneWay}"
                    SelectedItem="{x:Bind ViewModel.NewDepPredecessor, Mode=TwoWay}"
                    PlaceholderText="Select predecessor node"
                    HorizontalAlignment="Stretch"
                    AutomationProperties.Name="Predecessor node">
                    <ComboBox.ItemTemplate>
                        <DataTemplate x:DataType="models:WbsNode">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <TextBlock Text="{x:Bind Code}" FontWeight="SemiBold" />
                                <TextBlock Text="{x:Bind Title}" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>

                <ComboBox
                    x:Uid="WbsDetail_DependencyType"
                    ItemsSource="{x:Bind ViewModel.DependencyTypeOptions}"
                    SelectedItem="{x:Bind ViewModel.NewDepTypeOption, Mode=TwoWay}"
                    HorizontalAlignment="Stretch"
                    AutomationProperties.Name="Dependency type">
                    <ComboBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:DependencyTypeOption">
                            <StackPanel Spacing="1">
                                <TextBlock Text="{x:Bind Label}" />
                                <TextBlock
                                    Text="{x:Bind Description}"
                                    Style="{ThemeResource CaptionTextBlockStyle}"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    TextWrapping="Wrap" />
                            </StackPanel>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>

                <Button
                    x:Uid="WbsDetail_AddPredecessorBtn"
                    Content="Add Predecessor"
                    Command="{x:Bind ViewModel.AddDependencyCommand}"
                    AutomationProperties.Name="Add predecessor dependency" />

            <Rectangle
                Height="1"
                Fill="{ThemeResource DividerStrokeColorDefaultBrush}"
                Margin="0,8,0,4" />

            <TextBlock
                x:Uid="WbsDetail_LinkedMilestonesTitle"
                Text="Linked Milestones"
                Style="{StaticResource IscSectionTitleTextBlockStyle}" />

            <ItemsControl ItemsSource="{x:Bind ViewModel.LinkedMilestones, Mode=OneWay}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:MilestoneRowViewModel">
                        <Grid ColumnSpacing="8" Padding="0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock
                                Grid.Column="0"
                                Text="{x:Bind Milestone.Title}"
                                TextTrimming="CharacterEllipsis"
                                VerticalAlignment="Center" />
                            <TextBlock
                                Grid.Column="1"
                                Text="{x:Bind DueDateLabel}"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                FontSize="11"
                                VerticalAlignment="Center" />
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Rectangle
                Height="1"
                Fill="{ThemeResource DividerStrokeColorDefaultBrush}"
                Margin="0,8,0,4" />

            <TextBlock
                x:Uid="WbsDetail_NotesTitle"
                Text="Notes"
                Style="{StaticResource IscSectionTitleTextBlockStyle}" />

            <TextBox
                x:Uid="WbsDetail_NewNote"
                Text="{x:Bind ViewModel.NewNoteText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                PlaceholderText="What happened, or what was decided?"
                AcceptsReturn="True"
                TextWrapping="Wrap"
                MinHeight="60"
                AutomationProperties.Name="New note" />
            <Button
                x:Uid="WbsDetail_AddNoteBtn"
                Content="Add Note"
                Command="{x:Bind ViewModel.AddNoteCommand}"
                AutomationProperties.Name="Add note" />

            <ItemsControl ItemsSource="{x:Bind ViewModel.Notes, Mode=OneWay}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="models:NodeNote">
                        <Grid ColumnSpacing="8" Padding="0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="32" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="2">
                                <TextBlock
                                    Text="{x:Bind local:WbsDetailControl.NoteDate(CreatedAt)}"
                                    Style="{ThemeResource CaptionTextBlockStyle}"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock Text="{x:Bind Text}" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                            </StackPanel>
                            <Button
                                x:Uid="WbsDetail_DeleteNote"
                                Grid.Column="1"
                                VerticalAlignment="Top"
                                Content="&#xE74D;"
                                FontFamily="{ThemeResource SymbolThemeFontFamily}"
                                FontSize="12"
                                Padding="4"
                                Click="DeleteNote_Click"
                                AutomationProperties.Name="Delete note" />
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

        </StackPanel>
    </ScrollViewer>
</UserControl>
