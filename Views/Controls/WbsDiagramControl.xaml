<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="iscWBS.Views.Controls.WbsDiagramControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Resources>
        <!--
            Proxy brushes that pull from the WinUI 3 system ThemeDictionaries so that
            code-created Canvas children inherit the correct light/dark values.
        -->
        <SolidColorBrush x:Key="DiagramCardBackground" Color="{ThemeResource IscSurfaceColor}" />
        <SolidColorBrush x:Key="DiagramOnStatus"       Color="{ThemeResource WbsStatusOnFillColor}" />
        <SolidColorBrush x:Key="DiagramAccent"         Color="{ThemeResource IscAccentColor}" />
        <SolidColorBrush x:Key="DiagramOnAccent"       Color="{ThemeResource IscOnAccentColor}" />
        <SolidColorBrush x:Key="DiagramConnector"      Color="{ThemeResource IscConnectorColor}" />
        <SolidColorBrush x:Key="DiagramSelection"      Color="{ThemeResource SystemAccentColor}" />
        <SolidColorBrush x:Key="DiagramSecondaryText"  Color="{ThemeResource TextFillColorSecondary}" />
        <SolidColorBrush x:Key="DiagramStatusNotStarted" Color="{ThemeResource WbsStatusNotStartedColor}" />
        <SolidColorBrush x:Key="DiagramStatusInProgress" Color="{ThemeResource WbsStatusInProgressColor}" />
        <SolidColorBrush x:Key="DiagramStatusComplete"   Color="{ThemeResource WbsStatusCompleteColor}" />
        <SolidColorBrush x:Key="DiagramStatusBlocked"    Color="{ThemeResource WbsStatusBlockedColor}" />
    </UserControl.Resources>

    <ScrollViewer
        x:Name="DiagramScroller"
        HorizontalScrollBarVisibility="Auto"
        VerticalScrollBarVisibility="Auto"
        ZoomMode="Enabled"
        MinZoomFactor="0.25"
        MaxZoomFactor="3.0"
        IsTabStop="True"
        UseSystemFocusVisuals="False"
        PreviewKeyDown="DiagramScroller_PreviewKeyDown">
        <Canvas x:Name="DiagramCanvas" />
    </ScrollViewer>
</UserControl>
