<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="iscWBS.Views.DashboardPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:helpers="using:iscWBS.Helpers"
    xmlns:controls="using:iscWBS.Views.Controls"
    xmlns:vm="using:iscWBS.ViewModels"
    xmlns:models="using:iscWBS.Core.Models"
    xmlns:local="using:iscWBS.Views">

    <Page.Resources>
        <SolidColorBrush x:Key="DeliverableBadgeBackground" Color="{ThemeResource SystemAccentColor}" Opacity="0.22" />
        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{StaticResource IscCornerRadiusMedium}" />
            <Setter Property="Padding" Value="16" />
        </Style>
        <Style x:Key="KpiCardStyle" TargetType="Border" BasedOn="{StaticResource CardStyle}">
            <Setter Property="Padding" Value="14,12" />
        </Style>
        <Style x:Key="KpiToggleStyle" TargetType="ToggleButton" BasedOn="{StaticResource DefaultToggleButtonStyle}">
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="2" />
            <Setter Property="CornerRadius" Value="{StaticResource IscCornerRadiusMedium}" />
            <Setter Property="Padding" Value="13,11" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="VerticalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="VerticalContentAlignment" Value="Top" />
        </Style>
        <Style x:Key="KpiValueStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource IscFontFamily}" />
            <Setter Property="FontSize" Value="28" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style x:Key="KpiLabelStyle" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel
            Grid.Row="0"
            Orientation="Horizontal" Spacing="8"
            Margin="16,12,16,0">
            <TextBlock
                x:Uid="DashboardPage_Title"
                Text="Dashboard"
                Style="{StaticResource IscPageTitleTextBlockStyle}" />
            <Border Style="{StaticResource IscBadgeBorderStyle}">
                <TextBlock
                    x:Uid="DashboardPage_BetaFeature"
                    Text="BETA" Style="{StaticResource IscBadgeTextBlockStyle}"
                    AutomationProperties.Name="Beta feature" />
            </Border>
        </StackPanel>

        <Grid Grid.Row="1" Margin="16,12" ColumnSpacing="12" Visibility="{x:Bind ViewModel.HasNodes, Mode=OneWay}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <CalendarDatePicker
                Grid.Column="0"
                x:Uid="DashboardPage_FilterStartDate"
                Date="{x:Bind ViewModel.FilterStartDate, Mode=TwoWay}"
                PlaceholderText="Start date"
                AutomationProperties.Name="Filter start date" />
            <CalendarDatePicker
                Grid.Column="1"
                x:Uid="DashboardPage_FilterEndDate"
                Date="{x:Bind ViewModel.FilterEndDate, Mode=TwoWay}"
                PlaceholderText="End date"
                AutomationProperties.Name="Filter end date" />
            <ComboBox
                Grid.Column="2"
                x:Uid="DashboardPage_FilterAssignee"
                ItemsSource="{x:Bind ViewModel.AssigneeOptions, Mode=OneWay}"
                SelectedItem="{x:Bind ViewModel.SelectedAssignee, Mode=TwoWay}"
                PlaceholderText="Assignee"
                MinWidth="140"
                AutomationProperties.Name="Filter by assignee" />
        </Grid>

        <controls:IscEmptyState
            x:Uid="DashboardPage_Empty"
            Grid.Row="1" Grid.RowSpan="3"
            Illustration="EmptyBranch"
            Title="Nothing to report yet"
            Body="Add deliverables and work packages in the WBS Tree, and their progress shows up here."
            Visibility="{x:Bind ViewModel.IsEmptyProject, Mode=OneWay}" />

        <controls:IscEmptyState
            x:Uid="DashboardPage_NoMatches"
            Grid.Row="2" Grid.RowSpan="2"
            Illustration="NoResults"
            Title="Nothing matches these filters"
            Body="Try other filters, or clear them to see the whole project."
            ActionText="Clear Filters"
            Command="{x:Bind ViewModel.ClearFiltersCommand}"
            Visibility="{x:Bind ViewModel.NothingMatchesFilters, Mode=OneWay}" />

        <Grid Grid.Row="2" Margin="16,0,16,16" ColumnSpacing="12" Visibility="{x:Bind ViewModel.HasMatches, Mode=OneWay}">
            <!-- The status cards are toggle buttons that filter the list below; the selected one is outlined in the accent. -->
            <Grid.Resources>
                <SolidColorBrush x:Key="ToggleButtonBackgroundPointerOver" Color="{ThemeResource IscSurfaceColor}" />
                <SolidColorBrush x:Key="ToggleButtonBackgroundPressed" Color="{ThemeResource SystemAccentColor}" Opacity="0.12" />
                <SolidColorBrush x:Key="ToggleButtonBackgroundChecked" Color="{ThemeResource SystemAccentColor}" Opacity="0.18" />
                <SolidColorBrush x:Key="ToggleButtonBackgroundCheckedPointerOver" Color="{ThemeResource SystemAccentColor}" Opacity="0.24" />
                <SolidColorBrush x:Key="ToggleButtonBackgroundCheckedPressed" Color="{ThemeResource SystemAccentColor}" Opacity="0.12" />
                <SolidColorBrush x:Key="ToggleButtonBorderBrushPointerOver" Color="{ThemeResource SystemAccentColor}" Opacity="0.5" />
                <SolidColorBrush x:Key="ToggleButtonBorderBrushPressed" Color="{ThemeResource SystemAccentColor}" />
                <SolidColorBrush x:Key="ToggleButtonBorderBrushChecked" Color="{ThemeResource SystemAccentColor}" />
                <SolidColorBrush x:Key="ToggleButtonBorderBrushCheckedPointerOver" Color="{ThemeResource SystemAccentColor}" />
                <SolidColorBrush x:Key="ToggleButtonBorderBrushCheckedPressed" Color="{ThemeResource SystemAccentColor}" />
                <SolidColorBrush x:Key="ToggleButtonForegroundPointerOver" Color="{ThemeResource TextFillColorPrimary}" />
                <SolidColorBrush x:Key="ToggleButtonForegroundPressed" Color="{ThemeResource TextFillColorPrimary}" />
                <SolidColorBrush x:Key="ToggleButtonForegroundChecked" Color="{ThemeResource TextFillColorPrimary}" />
                <SolidColorBrush x:Key="ToggleButtonForegroundCheckedPointerOver" Color="{ThemeResource TextFillColorPrimary}" />
                <SolidColorBrush x:Key="ToggleButtonForegroundCheckedPressed" Color="{ThemeResource TextFillColorPrimary}" />
            </Grid.Resources>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource KpiCardStyle}">
                <StackPanel Spacing="6">
                    <TextBlock x:Uid="DashboardPage_KpiCompletePercent" Text="% Complete" Style="{StaticResource KpiLabelStyle}" />
                    <TextBlock x:Uid="DashboardPage_OverallPercentComplete" Text="{x:Bind ViewModel.OverallPercentText, Mode=OneWay}"
                               Style="{StaticResource KpiValueStyle}"
                               AutomationProperties.Name="Overall percent complete" />
                    <ProgressBar Value="{x:Bind ViewModel.Summary.PercentComplete, Mode=OneWay}" Maximum="100" AutomationProperties.AccessibilityView="Raw" />
                </StackPanel>
            </Border>

            <ToggleButton
                Grid.Column="1"
                x:Uid="DashboardPage_FilterNotStarted"
                Style="{StaticResource KpiToggleStyle}"
                IsChecked="{x:Bind ViewModel.IsNotStartedFilter, Mode=OneWay}"
                Command="{x:Bind ViewModel.ToggleStatusFilterCommand}"
                CommandParameter="NotStarted"
                AutomationProperties.Name="Show only not started tasks">
                <StackPanel Spacing="6">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <controls:StatusMarker Status="NotStarted" />
                        <TextBlock x:Uid="DashboardPage_KpiNotStarted" Text="Not Started" Style="{StaticResource KpiLabelStyle}" />
                    </StackPanel>
                    <TextBlock x:Uid="DashboardPage_NotStartedTaskCount" Text="{x:Bind ViewModel.NotStartedCount, Mode=OneWay}"
                               Style="{StaticResource KpiValueStyle}"
                               AutomationProperties.Name="Not started task count" />
                </StackPanel>
            </ToggleButton>

            <ToggleButton
                Grid.Column="2"
                x:Uid="DashboardPage_FilterInProgress"
                Style="{StaticResource KpiToggleStyle}"
                IsChecked="{x:Bind ViewModel.IsInProgressFilter, Mode=OneWay}"
                Command="{x:Bind ViewModel.ToggleStatusFilterCommand}"
                CommandParameter="InProgress"
                AutomationProperties.Name="Show only tasks in progress">
                <StackPanel Spacing="6">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <controls:StatusMarker Status="InProgress" />
                        <TextBlock x:Uid="DashboardPage_KpiInProgress" Text="In Progress" Style="{StaticResource KpiLabelStyle}" />
                    </StackPanel>
                    <TextBlock x:Uid="DashboardPage_InProgressTaskCount" Text="{x:Bind ViewModel.Summary.InProgressCount, Mode=OneWay}"
                               Style="{StaticResource KpiValueStyle}"
                               AutomationProperties.Name="In progress task count" />
                </StackPanel>
            </ToggleButton>

            <ToggleButton
                Grid.Column="3"
                x:Uid="DashboardPage_FilterComplete"
                Style="{StaticResource KpiToggleStyle}"
                IsChecked="{x:Bind ViewModel.IsCompleteFilter, Mode=OneWay}"
                Command="{x:Bind ViewModel.ToggleStatusFilterCommand}"
                CommandParameter="Complete"
                AutomationProperties.Name="Show only complete tasks">
                <StackPanel Spacing="6">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <controls:StatusMarker Status="Complete" />
                        <TextBlock x:Uid="DashboardPage_KpiComplete" Text="Complete" Style="{StaticResource KpiLabelStyle}" />
                    </StackPanel>
                    <TextBlock x:Uid="DashboardPage_CompleteTaskCount" Text="{x:Bind ViewModel.Summary.CompleteCount, Mode=OneWay}"
                               Style="{StaticResource KpiValueStyle}"
                               AutomationProperties.Name="Complete task count" />
                </StackPanel>
            </ToggleButton>

            <ToggleButton
                Grid.Column="4"
                x:Uid="DashboardPage_FilterBlocked"
                Style="{StaticResource KpiToggleStyle}"
                IsChecked="{x:Bind ViewModel.IsBlockedFilter, Mode=OneWay}"
                Command="{x:Bind ViewModel.ToggleStatusFilterCommand}"
                CommandParameter="Blocked"
                AutomationProperties.Name="Show only blocked tasks">
                <StackPanel Spacing="6">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <controls:StatusMarker Status="Blocked" />
                        <TextBlock x:Uid="DashboardPage_KpiBlocked" Text="Blocked" Style="{StaticResource KpiLabelStyle}" />
                    </StackPanel>
                    <TextBlock x:Uid="DashboardPage_BlockedTaskCount" Text="{x:Bind ViewModel.Summary.BlockedCount, Mode=OneWay}"
                               Style="{StaticResource KpiValueStyle}"
                               AutomationProperties.Name="Blocked task count" />
                </StackPanel>
            </ToggleButton>

            <Border Grid.Column="5" Style="{StaticResource KpiCardStyle}">
                <StackPanel Spacing="6">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE823;" FontSize="14" Foreground="{ThemeResource IscTextMutedBrush}" />
                        <TextBlock x:Uid="DashboardPage_KpiAtRisk" Text="At Risk" Style="{StaticResource KpiLabelStyle}" />
                    </StackPanel>
                    <TextBlock x:Uid="DashboardPage_AtRiskTaskCount" Text="{x:Bind ViewModel.Summary.AtRiskCount, Mode=OneWay}"
                               Style="{StaticResource KpiValueStyle}"
                               AutomationProperties.Name="At risk task count" />
                </StackPanel>
            </Border>

            <Border Grid.Column="6" Style="{StaticResource KpiCardStyle}">
                <StackPanel Spacing="6">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE7BA;" FontSize="14" Foreground="{ThemeResource WbsStatusBlockedBrush}" />
                        <TextBlock x:Uid="DashboardPage_KpiOverdue" Text="Overdue" Style="{StaticResource KpiLabelStyle}" />
                    </StackPanel>
                    <TextBlock x:Uid="DashboardPage_OverdueTaskCount" Text="{x:Bind ViewModel.Summary.OverdueCount, Mode=OneWay}"
                               Style="{StaticResource KpiValueStyle}"
                               AutomationProperties.Name="Overdue task count" />
                </StackPanel>
            </Border>
        </Grid>

        <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto" Visibility="{x:Bind ViewModel.HasMatches, Mode=OneWay}">
            <Grid Margin="16,0,16,16" ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="3*" />
                    <ColumnDefinition Width="2*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource CardStyle}" VerticalAlignment="Top">
                    <StackPanel Spacing="8">
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Viewbox Width="20" Height="20" VerticalAlignment="Center">
                                <PathIcon helpers:IscIcon.Kind="WorkPackage" Width="24" Height="24" />
                            </Viewbox>
                            <TextBlock Grid.Column="1" x:Uid="DashboardPage_TasksTitle" Text="Tasks" Style="{StaticResource IscSectionTitleTextBlockStyle}" />
                            <ToggleButton
                                Grid.Column="2"
                                x:Uid="DashboardPage_OnlyDeliverables"
                                IsChecked="{x:Bind ViewModel.OnlyDeliverables, Mode=TwoWay}"
                                AutomationProperties.Name="Show only deliverables">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <Viewbox Width="16" Height="16">
                                        <PathIcon helpers:IscIcon.Kind="Deliverable" Width="24" Height="24" />
                                    </Viewbox>
                                    <TextBlock x:Uid="DashboardPage_OnlyDeliverablesText" Text="Only deliverables" />
                                </StackPanel>
                            </ToggleButton>
                        </Grid>
                        <TextBlock
                            x:Uid="DashboardPage_NoMatchingRows"
                            Text="Nothing here with these filters."
                            Style="{ThemeResource BodyTextBlockStyle}"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Visibility="{x:Bind ViewModel.HasNoMatchingRows, Mode=OneWay}" />
                        <TextBlock
                            x:Uid="DashboardPage_NoDeliverables"
                            Text="Mark nodes as deliverables in the WBS Tree to follow their progress here."
                            Style="{ThemeResource BodyTextBlockStyle}"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Visibility="{x:Bind ViewModel.HasNoDeliverables, Mode=OneWay}" />
                        <ListView
                            x:Uid="DashboardPage_TasksList"
                            ItemsSource="{x:Bind ViewModel.Rows, Mode=OneWay}"
                            SelectionMode="None"
                            AutomationProperties.Name="Tasks list">
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    <Setter Property="Padding" Value="0" />
                                </Style>
                            </ListView.ItemContainerStyle>
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="models:ProgressRow">
                                    <Border
                                        Padding="4,10"
                                        BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                                        BorderThickness="0,0,0,1">
                                        <!-- Indented by depth, so the outline reads as in the tree -->
                                        <Grid RowSpacing="6" ColumnSpacing="12" Margin="{x:Bind local:DashboardPage.Indent(Depth)}">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <TextBlock
                                                Grid.Row="0" Grid.Column="0"
                                                Text="{x:Bind Code}"
                                                FontWeight="SemiBold" FontSize="11"
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                VerticalAlignment="Center" MinWidth="44" />
                                            <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Spacing="8">
                                                <TextBlock
                                                    Text="{x:Bind Title}"
                                                    FontWeight="SemiBold"
                                                    TextTrimming="CharacterEllipsis"
                                                    VerticalAlignment="Center" />
                                                <Border
                                                    Background="{StaticResource DeliverableBadgeBackground}"
                                                    CornerRadius="4" Padding="6,1" VerticalAlignment="Center"
                                                    Visibility="{x:Bind IsDeliverable}">
                                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                                        <Viewbox Width="12" Height="12">
                                                            <PathIcon helpers:IscIcon.Kind="Deliverable" Width="24" Height="24" />
                                                        </Viewbox>
                                                        <TextBlock x:Uid="DashboardPage_DeliverableBadge" Text="Deliverable" FontSize="10" FontWeight="SemiBold" />
                                                    </StackPanel>
                                                </Border>
                                            </StackPanel>
                                            <StackPanel Grid.Row="0" Grid.Column="2" Orientation="Horizontal" Spacing="6">
                                                <controls:StatusMarker Status="{x:Bind Status}" Width="14" Height="14" />
                                                <TextBlock
                                                    Text="{x:Bind Status, Converter={StaticResource StatusToStringConverter}}"
                                                    FontSize="11"
                                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                    VerticalAlignment="Center" />
                                            </StackPanel>
                                            <TextBlock
                                                Grid.Row="0" Grid.Column="3"
                                                Text="{x:Bind DueDateText}"
                                                FontSize="11"
                                                MinWidth="72"
                                                TextAlignment="Right"
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                VerticalAlignment="Center" />

                                            <Grid
                                                Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="4"
                                                ColumnSpacing="8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="36" />
                                                </Grid.ColumnDefinitions>
                                                <ProgressBar
                                                    x:Uid="DashboardPage_TaskProgress"
                                                    Grid.Column="0"
                                                    Value="{x:Bind ProgressFraction}"
                                                    Minimum="0" Maximum="1"
                                                    AutomationProperties.Name="Progress" />
                                                <TextBlock
                                                    Grid.Column="1"
                                                    Text="{x:Bind ProgressPercentText}"
                                                    FontSize="11"
                                                    TextAlignment="Right"
                                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                    VerticalAlignment="Center" />
                                            </Grid>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </StackPanel>
                </Border>

                <StackPanel Grid.Column="1" Spacing="16">

                    <Border Style="{StaticResource CardStyle}" Visibility="{x:Bind ViewModel.IsAllDone, Mode=OneWay}">
                        <StackPanel Spacing="4">
                            <Image x:Name="AllDoneImage" Width="192" Height="120" AutomationProperties.AccessibilityView="Raw" />
                            <TextBlock
                                x:Uid="DashboardPage_AllDoneTitle"
                                Text="Every branch is done"
                                FontFamily="{StaticResource IscFontFamily}" FontSize="18" FontWeight="SemiBold"
                                HorizontalAlignment="Center" />
                            <TextBlock
                                x:Uid="DashboardPage_AllDoneBody"
                                Text="All work in this project is complete. Nicely done."
                                Style="{ThemeResource BodyTextBlockStyle}"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                TextAlignment="Center" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel Spacing="8">
                            <TextBlock x:Uid="DashboardPage_StatusBreakdownTitle" Text="Status Breakdown" Style="{StaticResource IscSectionTitleTextBlockStyle}" />
                            <StackPanel Orientation="Horizontal" Spacing="24" HorizontalAlignment="Center" Margin="0,8">
                                <controls:StatusDonut
                                    x:Uid="DashboardPage_StatusBreakdownChart"
                                    Slices="{x:Bind ViewModel.StatusSlices, Mode=OneWay}"
                                    AutomationProperties.Name="Status breakdown chart" />
                                <ItemsControl ItemsSource="{x:Bind ViewModel.StatusSlices, Mode=OneWay}" VerticalAlignment="Center">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:StatusSlice">
                                            <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,4">
                                                <controls:StatusMarker Status="{x:Bind Status}" />
                                                <TextBlock Text="{x:Bind Label}" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel Spacing="8">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Viewbox Width="20" Height="20" VerticalAlignment="Center">
                                    <PathIcon helpers:IscIcon.Kind="Milestone" Width="24" Height="24" />
                                </Viewbox>
                                <TextBlock Text="{x:Bind ViewModel.MilestonesTitle, Mode=OneWay}" Style="{StaticResource IscSectionTitleTextBlockStyle}" TextWrapping="Wrap" />
                            </StackPanel>
                            <TextBlock
                                x:Uid="DashboardPage_NoMilestones"
                                Text="No open milestones in this period."
                                Style="{ThemeResource BodyTextBlockStyle}"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Visibility="{x:Bind ViewModel.HasNoUpcomingMilestones, Mode=OneWay}" />
                            <ListView
                                x:Uid="DashboardPage_UpcomingMilestonesList"
                                ItemsSource="{x:Bind ViewModel.UpcomingMilestones, Mode=OneWay}"
                                SelectionMode="None"
                                AutomationProperties.Name="Upcoming milestones list">
                                <ListView.ItemContainerStyle>
                                    <Style TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                        <Setter Property="Padding" Value="0" />
                                    </Style>
                                </ListView.ItemContainerStyle>
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="vm:MilestoneRowViewModel">
                                        <Grid ColumnSpacing="8" Padding="4,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock
                                                Grid.Column="0"
                                                Text="{x:Bind Milestone.Title}"
                                                TextTrimming="CharacterEllipsis"
                                                VerticalAlignment="Center" />
                                            <StackPanel
                                                Grid.Column="1"
                                                Orientation="Horizontal" Spacing="4"
                                                Visibility="{x:Bind IsOverdue}">
                                                <controls:StatusMarker Status="Blocked" Width="12" Height="12" />
                                                <TextBlock
                                                    x:Uid="MilestonesPage_StatusOverdue"
                                                    Text="Overdue"
                                                    FontWeight="SemiBold"
                                                    FontSize="11"
                                                    VerticalAlignment="Center" />
                                            </StackPanel>
                                            <TextBlock
                                                Grid.Column="2"
                                                Text="{x:Bind DueDateLabel}"
                                                FontSize="11"
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                VerticalAlignment="Center" />
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </StackPanel>
                    </Border>

                </StackPanel>
            </Grid>
        </ScrollViewer>

    </Grid>
</Page>
