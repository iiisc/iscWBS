<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="iscWBS.Views.GanttPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:iscWBS.Views.Controls">

    <!-- The chart is drawn in code; these proxies give it brushes that follow the theme. -->
    <Page.Resources>
        <SolidColorBrush x:Key="GanttLabelForeground"        Color="{ThemeResource GanttLabelForegroundColor}" />
        <SolidColorBrush x:Key="GanttHeaderBackground"       Color="{ThemeResource GanttHeaderBackgroundColor}" />
        <SolidColorBrush x:Key="GanttHeaderBottomBackground" Color="{ThemeResource GanttHeaderBottomBackgroundColor}" />
        <SolidColorBrush x:Key="GanttRowBand"                Color="{ThemeResource GanttRowBandColor}" />
        <SolidColorBrush x:Key="GanttAssigneeForeground"     Color="{ThemeResource TextFillColorSecondary}" />
        <SolidColorBrush x:Key="GanttToday"                  Color="{ThemeResource IscTextMutedColor}" />
        <SolidColorBrush x:Key="GanttConnector"              Color="{ThemeResource IscConnectorColor}" />
        <SolidColorBrush x:Key="GanttMilestone"              Color="{ThemeResource IscAccentColor}" />
        <SolidColorBrush x:Key="GanttOnStatus"               Color="{ThemeResource WbsStatusOnFillColor}" />
        <SolidColorBrush x:Key="GanttNotStarted"             Color="{ThemeResource WbsStatusNotStartedColor}" />
        <SolidColorBrush x:Key="GanttInProgress"             Color="{ThemeResource WbsStatusInProgressColor}" />
        <SolidColorBrush x:Key="GanttComplete"               Color="{ThemeResource WbsStatusCompleteColor}" />
        <SolidColorBrush x:Key="GanttBlocked"                Color="{ThemeResource WbsStatusBlockedColor}" />
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Toolbar: left-aligned so the zoom control stays away from the caption buttons -->
        <StackPanel
            Grid.Row="0"
            Orientation="Horizontal"
            Spacing="16"
            Padding="16,12,16,8">
            <TextBlock
                x:Uid="GanttPage_Title"
                Text="Gantt Chart"
                Style="{StaticResource IscPageTitleTextBlockStyle}" />
            <Border
                Style="{StaticResource IscBadgeBorderStyle}">
                <TextBlock
                    x:Uid="GanttPage_BetaFeature"
                    Text="BETA" Style="{StaticResource IscBadgeTextBlockStyle}"
                    AutomationProperties.Name="Beta feature" />
            </Border>
            <TextBlock
                x:Uid="GanttPage_ZoomLabel"
                Text="Zoom"
                VerticalAlignment="Center"
                Style="{ThemeResource BodyTextBlockStyle}" />
            <ComboBox
                x:Uid="GanttPage_ZoomCombo"
                Width="110"
                SelectedIndex="{x:Bind ViewModel.SelectedZoomIndex, Mode=TwoWay}"
                AutomationProperties.Name="Zoom level">
                <ComboBoxItem x:Uid="GanttPage_ZoomDay" Content="Day" />
                <ComboBoxItem x:Uid="GanttPage_ZoomWeek" Content="Week" />
                <ComboBoxItem x:Uid="GanttPage_ZoomMonth" Content="Month" />
            </ComboBox>
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border
                Grid.Column="0"
                BorderThickness="0,0,1,0"
                BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}">
                <Canvas x:Name="LabelHeaderCanvas" />
            </Border>
            <ScrollViewer
                x:Name="HeaderScrollViewer"
                Grid.Column="1"
                HorizontalScrollBarVisibility="Hidden"
                VerticalScrollBarVisibility="Disabled"
                IsTabStop="False">
                <Canvas x:Name="HeaderCanvas" HorizontalAlignment="Left" />
            </ScrollViewer>
        </Grid>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border
                Grid.Column="0"
                BorderThickness="0,0,1,0"
                BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}">
                <ScrollViewer
                    x:Name="LabelScrollViewer"
                    VerticalScrollBarVisibility="Hidden"
                    HorizontalScrollBarVisibility="Disabled"
                    IsTabStop="False">
                    <Canvas x:Name="LabelCanvas" HorizontalAlignment="Left" VerticalAlignment="Top" />
                </ScrollViewer>
            </Border>
            <ScrollViewer
                x:Name="GanttScrollViewer"
                Grid.Column="1"
                HorizontalScrollBarVisibility="Auto"
                VerticalScrollBarVisibility="Auto"
                ViewChanged="GanttScrollViewer_ViewChanged">
                <Canvas x:Name="ChartCanvas" HorizontalAlignment="Left" VerticalAlignment="Top" />
            </ScrollViewer>
        </Grid>

        <Grid Grid.Row="1" Grid.RowSpan="2" Background="{ThemeResource NavigationViewContentBackground}" Visibility="{x:Bind ViewModel.IsEmpty, Mode=OneWay}">
            <controls:IscEmptyState
                x:Uid="GanttPage_Empty"
                Illustration="NothingScheduled"
                Title="Nothing scheduled yet"
                Body="Give work packages start and end dates to see them on the timeline." />
        </Grid>
    </Grid>
</Page>

