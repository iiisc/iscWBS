<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="iscWBS.Views.ReportsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- The banner art is always on Night, so its title stays white in both themes. -->
        <Border
            x:Name="Banner"
            Grid.Row="0"
            Margin="16,16,16,0"
            MaxWidth="800"
            Height="200"
            CornerRadius="{StaticResource IscCornerRadiusLarge}"
            Background="{StaticResource IscNightBrush}">
            <Grid>
                <Image x:Name="BannerImage" Stretch="UniformToFill" HorizontalAlignment="Right" AutomationProperties.AccessibilityView="Raw" />
                <StackPanel Orientation="Horizontal" Spacing="12" Margin="32,0" VerticalAlignment="Center">
                    <TextBlock
                        x:Uid="ReportsPage_Title"
                        Text="Reports"
                        FontFamily="{StaticResource IscFontFamily}"
                        FontWeight="SemiBold"
                        FontSize="36"
                        Foreground="White" />
                    <Border Style="{StaticResource IscBadgeBorderStyle}">
                        <TextBlock
                            x:Uid="ReportsPage_BetaFeature"
                            Text="BETA" Style="{StaticResource IscBadgeTextBlockStyle}"
                            AutomationProperties.Name="Beta feature" />
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <StackPanel
            x:Name="PlainHeader"
            Grid.Row="0"
            Orientation="Horizontal" Spacing="8"
            Margin="16,12,16,0"
            Visibility="Collapsed">
            <TextBlock
                x:Uid="ReportsPage_Title"
                Text="Reports"
                Style="{StaticResource IscPageTitleTextBlockStyle}" />
            <Border Style="{StaticResource IscBadgeBorderStyle}">
                <TextBlock
                    x:Uid="ReportsPage_BetaFeature"
                    Text="BETA" Style="{StaticResource IscBadgeTextBlockStyle}"
                    AutomationProperties.Name="Beta feature" />
            </Border>
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel
                Spacing="20"
                Padding="24,20,24,24"
                MaxWidth="480"
                HorizontalAlignment="Center">

                <TextBlock
                    x:Uid="ReportsPage_Subtitle"
                    Text="Customise and generate a PDF snapshot of the current project status."
                    Style="{ThemeResource BodyTextBlockStyle}"
                    TextAlignment="Center"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                <Border
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                    CornerRadius="8" Padding="16,14">
                    <StackPanel Spacing="4">

                        <TextBlock
                            x:Uid="ReportsPage_SectionsTitle"
                            Text="Sections to include"
                            Style="{StaticResource IscSectionTitleTextBlockStyle}"
                            Margin="0,0,0,8" />

                        <ToggleSwitch
                            x:Uid="ReportsPage_ToggleSummary"
                            IsOn="{x:Bind ViewModel.IncludeSummary, Mode=TwoWay}"
                            Header="Summary (KPI totals)"
                            OnContent="Included" OffContent="Excluded"
                            AutomationProperties.Name="Include summary section" />

                        <NavigationViewItemSeparator Margin="-4,4" />

                        <ToggleSwitch
                            x:Uid="ReportsPage_ToggleAttention"
                            IsOn="{x:Bind ViewModel.IncludeAttentionRequired, Mode=TwoWay}"
                            Header="Attention Required"
                            OnContent="Included" OffContent="Excluded"
                            AutomationProperties.Name="Include attention required section" />

                        <ToggleSwitch
                            x:Uid="ReportsPage_ToggleDeliverables"
                            IsOn="{x:Bind ViewModel.IncludeDeliverables, Mode=TwoWay}"
                            Header="Deliverables"
                            OnContent="Included" OffContent="Excluded"
                            AutomationProperties.Name="Include deliverables section" />

                        <ToggleSwitch
                            x:Uid="ReportsPage_ToggleEffort"
                            IsOn="{x:Bind ViewModel.IncludeEffortSummary, Mode=TwoWay}"
                            Header="Effort Summary"
                            OnContent="Included" OffContent="Excluded"
                            AutomationProperties.Name="Include effort summary section" />

                        <ToggleSwitch
                            x:Uid="ReportsPage_ToggleMilestones"
                            IsOn="{x:Bind ViewModel.IncludeMilestones, Mode=TwoWay}"
                            Header="Upcoming Milestones"
                            OnContent="Included" OffContent="Excluded"
                            AutomationProperties.Name="Include upcoming milestones section" />

                        <ToggleSwitch
                            x:Uid="ReportsPage_ToggleWbsTree"
                            IsOn="{x:Bind ViewModel.IncludeWbsTree, Mode=TwoWay}"
                            Header="WBS Tree Outline"
                            OnContent="Included" OffContent="Excluded"
                            AutomationProperties.Name="Include WBS tree outline section" />

                    </StackPanel>
                </Border>

                <Button
                    x:Uid="ReportsPage_ExportPdfButton"
                    Style="{ThemeResource AccentButtonStyle}"
                    HorizontalAlignment="Center"
                    AutomationProperties.Name="Generate PDF report"
                    Command="{x:Bind ViewModel.ExportPdfCommand}">
                    <Button.KeyboardAccelerators>
                        <KeyboardAccelerator Modifiers="Control" Key="E" />
                    </Button.KeyboardAccelerators>
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE792;" FontSize="14" />
                        <TextBlock x:Uid="ReportsPage_GeneratePdfBtn" Text="Generate PDF Report" />
                    </StackPanel>
                </Button>

                <TextBlock
                    Text="{x:Bind ViewModel.LastExportPath, Mode=OneWay}"
                    Style="{ThemeResource CaptionTextBlockStyle}"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    TextAlignment="Center"
                    TextTrimming="CharacterEllipsis"
                    Visibility="{x:Bind ViewModel.HasLastExportPath, Mode=OneWay}" />

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>

