<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="iscWBS.Views.RisksPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:iscWBS.ViewModels"
    xmlns:controls="using:iscWBS.Views.Controls">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel
            Grid.Row="0"
            Orientation="Horizontal"
            Spacing="8"
            Padding="12,8">
            <TextBox
                x:Uid="RisksPage_NewTitleInput"
                Text="{x:Bind ViewModel.NewTitle, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                PlaceholderText="What could go wrong?"
                Width="280"
                AutomationProperties.Name="New risk title" />
            <Button
                x:Uid="RisksPage_AddRiskBtn"
                Content="Add Risk"
                Command="{x:Bind ViewModel.AddRiskCommand}"
                Style="{ThemeResource AccentButtonStyle}"
                AutomationProperties.Name="Add risk" />
            <AppBarSeparator />
            <controls:UndoRedoButtons />
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <ListView
                x:Uid="RisksPage_RiskList"
                Grid.Column="0"
                AutomationProperties.Name="Risks"
                ItemsSource="{x:Bind ViewModel.Risks, Mode=OneWay}"
                SelectedItem="{x:Bind ViewModel.SelectedRisk, Mode=TwoWay}"
                SelectionMode="Single">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="vm:RiskRowViewModel">
                        <Grid ColumnSpacing="12" Padding="0,6" Opacity="{x:Bind Opacity}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="96" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="32" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6">
                                <Ellipse Width="10" Height="10" VerticalAlignment="Center" Fill="{ThemeResource WbsStatusBlockedBrush}" Visibility="{x:Bind IsHigh}" />
                                <Ellipse Width="10" Height="10" VerticalAlignment="Center" Fill="{ThemeResource SystemFillColorCautionBrush}" Visibility="{x:Bind IsMedium}" />
                                <Ellipse Width="10" Height="10" VerticalAlignment="Center" Fill="{ThemeResource WbsStatusNotStartedBrush}" Visibility="{x:Bind IsLow}" />
                                <controls:StatusMarker Status="Complete" Width="14" Height="14" Visibility="{x:Bind Risk.IsClosed}" />
                                <TextBlock
                                    Text="{x:Bind StatusLabel}"
                                    FontSize="12"
                                    FontWeight="SemiBold"
                                    VerticalAlignment="Center" />
                            </StackPanel>

                            <TextBlock
                                Grid.Column="1"
                                Text="{x:Bind Risk.Title}"
                                TextTrimming="CharacterEllipsis"
                                VerticalAlignment="Center" />
                            <TextBlock
                                Grid.Column="2"
                                Text="{x:Bind Risk.Owner}"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                FontSize="12"
                                VerticalAlignment="Center" />
                            <TextBlock
                                Grid.Column="3"
                                Text="{x:Bind RatingLabel}"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                FontSize="12"
                                VerticalAlignment="Center" />
                            <Button
                                x:Uid="RisksPage_DeleteRisk"
                                Grid.Column="4"
                                Content="&#xE74D;"
                                FontFamily="{ThemeResource SymbolThemeFontFamily}"
                                FontSize="12"
                                Padding="4"
                                Click="DeleteRisk_Click"
                                AutomationProperties.Name="Delete risk" />
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <controls:IscEmptyState
                x:Uid="RisksPage_Empty"
                Grid.Column="0"
                Illustration="NoResults"
                Title="No risks logged"
                Body="Write down what could delay or derail the project, how likely it is, and what's being done about it."
                Visibility="{x:Bind ViewModel.HasNoRisks, Mode=OneWay}" />

            <ScrollViewer
                Grid.Column="1"
                Width="340"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1,0,0,0"
                VerticalScrollBarVisibility="Auto"
                Visibility="{x:Bind ViewModel.IsDetailVisible, Mode=OneWay}">
                <StackPanel Spacing="12" Padding="16">

                    <TextBlock
                        x:Uid="RisksPage_DetailTitle"
                        Text="Risk Details"
                        Style="{StaticResource IscSectionTitleTextBlockStyle}" />

                    <TextBox
                        x:Uid="RisksPage_RiskTitle"
                        Header="Title"
                        Text="{x:Bind ViewModel.EditTitle, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        AutomationProperties.Name="Risk title" />

                    <TextBox
                        x:Uid="RisksPage_RiskDescription"
                        Header="Description"
                        Text="{x:Bind ViewModel.EditDescription, Mode=TwoWay}"
                        AcceptsReturn="True"
                        TextWrapping="Wrap"
                        MinHeight="64"
                        AutomationProperties.Name="Risk description" />

                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <ComboBox
                            x:Uid="RisksPage_Likelihood"
                            Grid.Column="0"
                            Header="Likelihood"
                            ItemsSource="{x:Bind ViewModel.LevelOptions}"
                            SelectedItem="{x:Bind ViewModel.EditLikelihood, Mode=TwoWay}"
                            HorizontalAlignment="Stretch"
                            AutomationProperties.Name="Likelihood" />
                        <ComboBox
                            x:Uid="RisksPage_Impact"
                            Grid.Column="1"
                            Header="Impact"
                            ItemsSource="{x:Bind ViewModel.LevelOptions}"
                            SelectedItem="{x:Bind ViewModel.EditImpact, Mode=TwoWay}"
                            HorizontalAlignment="Stretch"
                            AutomationProperties.Name="Impact" />
                    </Grid>

                    <TextBox
                        x:Uid="RisksPage_RiskOwner"
                        Header="Owner"
                        Text="{x:Bind ViewModel.EditOwner, Mode=TwoWay}"
                        AutomationProperties.Name="Risk owner" />

                    <TextBox
                        x:Uid="RisksPage_RiskResponse"
                        Header="Response"
                        PlaceholderText="What is being done to prevent it or soften it"
                        Text="{x:Bind ViewModel.EditResponse, Mode=TwoWay}"
                        AcceptsReturn="True"
                        TextWrapping="Wrap"
                        MinHeight="64"
                        AutomationProperties.Name="Risk response" />

                    <CheckBox
                        x:Uid="RisksPage_RiskClosed"
                        Content="Closed (no longer a risk)"
                        IsChecked="{x:Bind ViewModel.EditIsClosed, Mode=TwoWay}" />

                    <Button
                        x:Uid="RisksPage_SaveBtn"
                        Content="Save"
                        Command="{x:Bind ViewModel.SaveEditCommand}"
                        Style="{ThemeResource AccentButtonStyle}"
                        AutomationProperties.Name="Save risk" />

                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</Page>
