<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="iscWBS.Views.WbsOutlinePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:iscWBS.Core.Models"
    xmlns:viewmodels="using:iscWBS.ViewModels"
    xmlns:controls="using:iscWBS.Views.Controls">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel
            Grid.Row="0"
            Orientation="Horizontal"
            Spacing="8"
            Padding="16,12,16,8">
            <TextBlock
                x:Uid="WbsOutlinePage_Title"
                Text="WBS Outline"
                Style="{StaticResource IscPageTitleTextBlockStyle}" />
        </StackPanel>

        <!-- Column headers -->
        <Grid Grid.Row="1" Padding="12,4" Background="{ThemeResource SubtleFillColorSecondaryBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="100" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="120" />
                <ColumnDefinition Width="120" />
                <ColumnDefinition Width="130" />
                <ColumnDefinition Width="110" />
                <ColumnDefinition Width="110" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Uid="WbsOutlinePage_ColCode" Grid.Column="0" Text="Code" FontWeight="SemiBold" />
            <TextBlock x:Uid="WbsOutlinePage_ColTitle" Grid.Column="1" Text="Title" FontWeight="SemiBold" />
            <TextBlock x:Uid="WbsOutlinePage_ColAssignedTo" Grid.Column="2" Text="Assigned To" FontWeight="SemiBold" />
            <TextBlock x:Uid="WbsOutlinePage_ColStatus" Grid.Column="3" Text="Status" FontWeight="SemiBold" />
            <TextBlock x:Uid="WbsOutlinePage_ColEstHours" Grid.Column="4" Text="Est. Hours" FontWeight="SemiBold" />
            <TextBlock x:Uid="WbsOutlinePage_ColActHours" Grid.Column="5" Text="Act. Hours" FontWeight="SemiBold" />
            <TextBlock x:Uid="WbsOutlinePage_ColDueDate" Grid.Column="6" Text="Due Date" FontWeight="SemiBold" />
        </Grid>

        <ListView
            x:Uid="WbsOutlinePage_OutlineListView"
            x:Name="OutlineListView"
            Grid.Row="2"
            ItemsSource="{x:Bind ViewModel.Nodes, Mode=OneWay}"
            SelectionMode="Single"
            SelectionChanged="OutlineListView_SelectionChanged"
            AutomationProperties.Name="WBS outline">
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="Padding" Value="12,4" />
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="viewmodels:WbsOutlineRowViewModel">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="100" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="120" />
                            <ColumnDefinition Width="120" />
                            <ColumnDefinition Width="130" />
                            <ColumnDefinition Width="110" />
                            <ColumnDefinition Width="110" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8">
                            <controls:LevelMarker Level="{x:Bind Level}" Width="12" Height="12" VerticalAlignment="Center" />
                            <TextBlock Text="{x:Bind Code}" FontWeight="SemiBold" />
                        </StackPanel>
                        <TextBlock Grid.Column="1" Text="{x:Bind Title}" />
                        <TextBlock Grid.Column="2" Text="{x:Bind AssignedTo}" />
                        <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="6">
                            <controls:StatusMarker Status="{x:Bind EffectiveStatus}" Width="14" Height="14" />
                            <TextBlock Text="{x:Bind EffectiveStatus, Converter={StaticResource StatusToStringConverter}}" />
                        </StackPanel>
                        <TextBlock Grid.Column="4" Text="{x:Bind EstimatedHours}" />
                        <TextBlock Grid.Column="5" Text="{x:Bind ActualHours}" />
                        <TextBlock Grid.Column="6" Text="{x:Bind DueDateText}" />
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <controls:IscEmptyState
            x:Uid="WbsOutlinePage_Empty"
            Grid.Row="1" Grid.RowSpan="2"
            Illustration="EmptyBranch"
            Title="This outline is still bare"
            Body="Build the tree first. Every node you add there is listed here with its code, owner and status."
            ActionText="Open WBS Tree"
            Command="{x:Bind ViewModel.OpenTreeCommand}"
            Visibility="{x:Bind ViewModel.HasNoNodes, Mode=OneWay}" />
    </Grid>
</Page>
