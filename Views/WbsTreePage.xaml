<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="iscWBS.Views.WbsTreePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:helpers="using:iscWBS.Helpers"
    xmlns:vm="using:iscWBS.ViewModels"
    xmlns:controls="using:iscWBS.Views.Controls">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Left-aligned and kept short, so nothing sits under the window's caption buttons -->
        <StackPanel
            Grid.Row="0"
            Padding="12,8"
            Orientation="Horizontal"
            Spacing="8">
            <Button
                x:Uid="WbsTreePage_AddRootNodeBtn"
                Command="{x:Bind ViewModel.AddRootNodeCommand}"
                AutomationProperties.Name="Add root node">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Viewbox Width="16" Height="16">
                        <PathIcon helpers:IscIcon.Kind="AddSibling" Width="24" Height="24" />
                    </Viewbox>
                    <TextBlock x:Uid="WbsTreePage_AddRootNodeText" Text="Add Root Node" />
                </StackPanel>
                <Button.KeyboardAccelerators>
                    <KeyboardAccelerator Modifiers="Control,Shift" Key="N" />
                </Button.KeyboardAccelerators>
            </Button>
            <Button
                x:Uid="WbsTreePage_AddChildBtn"
                Command="{x:Bind ViewModel.AddChildNodeCommand}"
                CommandParameter="{x:Bind ViewModel.SelectedNode, Mode=OneWay}"
                IsEnabled="{x:Bind ViewModel.IsDetailVisible, Mode=OneWay}"
                AutomationProperties.Name="Add child node">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Viewbox Width="16" Height="16">
                        <PathIcon helpers:IscIcon.Kind="AddChild" Width="24" Height="24" />
                    </Viewbox>
                    <TextBlock x:Uid="WbsTreePage_AddChildText" Text="Add Child" />
                </StackPanel>
                <Button.KeyboardAccelerators>
                    <KeyboardAccelerator Modifiers="Control" Key="N" />
                </Button.KeyboardAccelerators>
            </Button>
            <Button
                x:Uid="WbsTreePage_DuplicateBtn"
                Command="{x:Bind ViewModel.DuplicateNodeCommand}"
                CommandParameter="{x:Bind ViewModel.SelectedNode, Mode=OneWay}"
                IsEnabled="{x:Bind ViewModel.IsDetailVisible, Mode=OneWay}"
                ToolTipService.ToolTip="Copy the node and everything under it (Ctrl+D)"
                AutomationProperties.Name="Copy node with its branch">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE8C8;" FontSize="16" />
                    <TextBlock x:Uid="WbsTreePage_DuplicateText" Text="Copy" />
                </StackPanel>
                <Button.KeyboardAccelerators>
                    <KeyboardAccelerator Modifiers="Control" Key="D" ScopeOwner="{x:Bind WbsDiagram}" />
                </Button.KeyboardAccelerators>
            </Button>
            <Button
                x:Uid="WbsTreePage_DeleteNodeBtn"
                Command="{x:Bind ViewModel.DeleteNodeCommand}"
                CommandParameter="{x:Bind ViewModel.SelectedNode, Mode=OneWay}"
                IsEnabled="{x:Bind ViewModel.IsDetailVisible, Mode=OneWay}"
                AutomationProperties.Name="Delete selected node">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE74D;" FontSize="16" />
                    <TextBlock x:Uid="WbsTreePage_DeleteNodeText" Text="Delete Node" />
                </StackPanel>
                <Button.KeyboardAccelerators>
                    <!-- Scoped to the diagram so Delete in a detail text box still deletes text. -->
                    <KeyboardAccelerator Key="Delete" ScopeOwner="{x:Bind WbsDiagram}" />
                </Button.KeyboardAccelerators>
            </Button>
            <AppBarSeparator />
            <!-- Alt+arrows follow the diagram's layout: siblings run left to right, children below. -->
            <Button
                x:Uid="WbsTreePage_MoveEarlierBtn"
                Command="{x:Bind ViewModel.MoveEarlierCommand}"
                ToolTipService.ToolTip="Move earlier (Alt+Left)"
                AutomationProperties.Name="Move earlier">
                <FontIcon Glyph="&#xE76B;" FontSize="16" />
                <Button.KeyboardAccelerators>
                    <KeyboardAccelerator Modifiers="Menu" Key="Left" ScopeOwner="{x:Bind WbsDiagram}" />
                </Button.KeyboardAccelerators>
            </Button>
            <Button
                x:Uid="WbsTreePage_MoveLaterBtn"
                Command="{x:Bind ViewModel.MoveLaterCommand}"
                ToolTipService.ToolTip="Move later (Alt+Right)"
                AutomationProperties.Name="Move later">
                <FontIcon Glyph="&#xE76C;" FontSize="16" />
                <Button.KeyboardAccelerators>
                    <KeyboardAccelerator Modifiers="Menu" Key="Right" ScopeOwner="{x:Bind WbsDiagram}" />
                </Button.KeyboardAccelerators>
            </Button>
            <Button
                x:Uid="WbsTreePage_OutdentBtn"
                Command="{x:Bind ViewModel.OutdentCommand}"
                ToolTipService.ToolTip="Move up a level (Alt+Up)"
                AutomationProperties.Name="Move up a level">
                <Viewbox Width="16" Height="16">
                    <PathIcon helpers:IscIcon.Kind="Outdent" Width="24" Height="24" />
                </Viewbox>
                <Button.KeyboardAccelerators>
                    <KeyboardAccelerator Modifiers="Menu" Key="Up" ScopeOwner="{x:Bind WbsDiagram}" />
                </Button.KeyboardAccelerators>
            </Button>
            <Button
                x:Uid="WbsTreePage_IndentBtn"
                Command="{x:Bind ViewModel.IndentCommand}"
                ToolTipService.ToolTip="Move under the node before it (Alt+Down)"
                AutomationProperties.Name="Move under the node before it">
                <Viewbox Width="16" Height="16">
                    <PathIcon helpers:IscIcon.Kind="Indent" Width="24" Height="24" />
                </Viewbox>
                <Button.KeyboardAccelerators>
                    <KeyboardAccelerator Modifiers="Menu" Key="Down" ScopeOwner="{x:Bind WbsDiagram}" />
                </Button.KeyboardAccelerators>
            </Button>
            <AppBarSeparator />
            <Button
                x:Uid="WbsTreePage_CollapseAllBtn"
                Click="CollapseAll_Click"
                AutomationProperties.Name="Collapse all nodes">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Viewbox Width="16" Height="16">
                        <PathIcon helpers:IscIcon.Kind="Collapse" Width="24" Height="24" />
                    </Viewbox>
                    <TextBlock x:Uid="WbsTreePage_CollapseAllText" Text="Collapse All" />
                </StackPanel>
            </Button>
            <Button
                x:Uid="WbsTreePage_ExpandAllBtn"
                Click="ExpandAll_Click"
                AutomationProperties.Name="Expand all nodes">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Viewbox Width="16" Height="16">
                        <PathIcon helpers:IscIcon.Kind="Expand" Width="24" Height="24" />
                    </Viewbox>
                    <TextBlock x:Uid="WbsTreePage_ExpandAllText" Text="Expand All" />
                </StackPanel>
            </Button>
            <AppBarSeparator />
            <controls:UndoRedoButtons />
            <AppBarSeparator />
            <AutoSuggestBox
                x:Name="SearchBox"
                x:Uid="WbsTreePage_Search"
                Width="200"
                PlaceholderText="Find a node (Ctrl+F)"
                QueryIcon="Find"
                ItemsSource="{x:Bind ViewModel.SearchResults, Mode=OneWay}"
                TextChanged="SearchBox_TextChanged"
                QuerySubmitted="SearchBox_QuerySubmitted"
                AutomationProperties.Name="Find a node">
                <AutoSuggestBox.KeyboardAccelerators>
                    <KeyboardAccelerator Modifiers="Control" Key="F" Invoked="FocusSearch_Invoked" />
                </AutoSuggestBox.KeyboardAccelerators>
            </AutoSuggestBox>
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="320" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0">
                <controls:WbsDiagramControl
                    x:Name="WbsDiagram"
                    AllNodes="{x:Bind ViewModel.DiagramNodes, Mode=OneWay}"
                    Dependencies="{x:Bind ViewModel.DiagramDependencies, Mode=OneWay}"
                    BlockedNodeIds="{x:Bind ViewModel.BlockedNodeIds, Mode=OneWay}"
                    CompletionBlockedNodeIds="{x:Bind ViewModel.CompletionBlockedNodeIds, Mode=OneWay}"
                    ViolatedCompleteNodeIds="{x:Bind ViewModel.ViolatedCompleteNodeIds, Mode=OneWay}"
                    ViolatedInProgressNodeIds="{x:Bind ViewModel.ViolatedInProgressNodeIds, Mode=OneWay}"
                    SelectedNodeId="{x:Bind ViewModel.SelectedNodeId, Mode=OneWay}">
                    <FlyoutBase.AttachedFlyout>
                        <MenuFlyout>
                            <MenuFlyoutItem
                                x:Uid="WbsTreePage_ContextAddChild"
                                Text="Add Child"
                                Command="{x:Bind ViewModel.AddChildNodeCommand}"
                                CommandParameter="{x:Bind ViewModel.SelectedNode, Mode=OneWay}"
                                AutomationProperties.Name="Add child node">
                                <MenuFlyoutItem.Icon>
                                    <PathIcon helpers:IscIcon.Kind="AddChild" Width="24" Height="24" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem
                                x:Uid="WbsTreePage_ContextAddSibling"
                                Text="Add Sibling"
                                Command="{x:Bind ViewModel.AddSiblingNodeCommand}"
                                CommandParameter="{x:Bind ViewModel.SelectedNode, Mode=OneWay}"
                                AutomationProperties.Name="Add sibling node">
                                <MenuFlyoutItem.Icon>
                                    <PathIcon helpers:IscIcon.Kind="AddSibling" Width="24" Height="24" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem
                                x:Uid="WbsTreePage_ContextDuplicate"
                                Text="Copy with Branch"
                                Command="{x:Bind ViewModel.DuplicateNodeCommand}"
                                CommandParameter="{x:Bind ViewModel.SelectedNode, Mode=OneWay}">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xE8C8;" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutSeparator />
                            <MenuFlyoutItem
                                x:Uid="WbsTreePage_ContextMoveEarlier"
                                Text="Move Earlier"
                                Command="{x:Bind ViewModel.MoveEarlierCommand}">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xE76B;" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem
                                x:Uid="WbsTreePage_ContextMoveLater"
                                Text="Move Later"
                                Command="{x:Bind ViewModel.MoveLaterCommand}">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xE76C;" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem
                                x:Uid="WbsTreePage_ContextOutdent"
                                Text="Move Up a Level"
                                Command="{x:Bind ViewModel.OutdentCommand}">
                                <MenuFlyoutItem.Icon>
                                    <PathIcon helpers:IscIcon.Kind="Outdent" Width="24" Height="24" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem
                                x:Uid="WbsTreePage_ContextIndent"
                                Text="Move Under the Node Before It"
                                Command="{x:Bind ViewModel.IndentCommand}">
                                <MenuFlyoutItem.Icon>
                                    <PathIcon helpers:IscIcon.Kind="Indent" Width="24" Height="24" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutSeparator />
                            <MenuFlyoutItem
                                x:Uid="WbsTreePage_ContextDelete"
                                Text="Delete"
                                Command="{x:Bind ViewModel.DeleteNodeCommand}"
                                CommandParameter="{x:Bind ViewModel.SelectedNode, Mode=OneWay}"
                                AutomationProperties.Name="Delete node">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xE74D;" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                        </MenuFlyout>
                    </FlyoutBase.AttachedFlyout>
                </controls:WbsDiagramControl>

                <InfoBar
                    x:Uid="WbsTreePage_Rescheduled"
                    Margin="12"
                    VerticalAlignment="Bottom"
                    Severity="Informational"
                    Title="Moved later to keep dependencies"
                    Message="{x:Bind ViewModel.RescheduleNotice, Mode=OneWay}"
                    IsOpen="{x:Bind ViewModel.HasRescheduleNotice, Mode=TwoWay}" />

                <controls:IscEmptyState
                    x:Uid="WbsTreePage_Empty"
                    Illustration="EmptyProjects"
                    Title="Plant the root of your project"
                    Body="Start with a root node, then break it down into deliverables and work packages."
                    ActionText="Add Root Node"
                    Command="{x:Bind ViewModel.AddRootNodeCommand}"
                    Visibility="{x:Bind ViewModel.HasNoNodes, Mode=OneWay}" />
            </Grid>

            <!-- The pane, divider included, takes no room while nothing is selected. -->
            <Border
                Grid.Column="1"
                Width="300"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1,0,0,0"
                Visibility="{x:Bind ViewModel.IsDetailVisible, Mode=OneWay}">
                <controls:WbsDetailControl
                    x:Name="DetailControl"
                    ViewModel="{x:Bind ViewModel, Mode=OneWay}" />
            </Border>
        </Grid>
    </Grid>
</Page>
