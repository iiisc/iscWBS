<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>iscWBS</RootNamespace>
    <!-- Releases pass the real version; 0.0.0 marks a local build -->
    <Version>0.0.0</Version>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- Only x64 is released. Set here, a plain dotnet build or publish makes exactly what ships. -->
    <Platforms>x64</Platforms>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <!-- Compiled to native code holding only the parts of .NET the app calls, so no .NET runtime files ship with it -->
    <PublishAot>true</PublishAot>
    <OptimizationPreference>Size</OptimizationPreference>
    <!-- CsWinRT only generates the AOT marshalling code for collections bound to ItemsSource when this is on -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <DebugType Condition="'$(Configuration)' == 'Release'">none</DebugType>
    <SatelliteResourceLanguages>en;en-US;sv;sv-SE</SatelliteResourceLanguages>
    <UseWinUI>true</UseWinUI>
    <WinUISDKReferences>false</WinUISDKReferences>
    <!-- Ships as a plain exe, so debug runs the same way instead of as an MSIX package -->
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <!-- Still needed although the app isn't packaged: it builds iscWBS.pri, which holds the compiled XAML and strings -->
    <EnableMsixTooling>true</EnableMsixTooling>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- The test project lives inside this folder but builds on its own -->
    <DefaultItemExcludes>$(DefaultItemExcludes);tests\**</DefaultItemExcludes>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.14" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.28000.2957" />
    <PackageReference Include="Microsoft.WindowsAppSDK.WinUI" Version="2.6.4" />
    <PackageReference Include="QuestPDF" Version="2026.9.1" />
    <!-- A current native SQLite (the version number is SQLite's own); Microsoft.Data.Sqlite alone resolves an older 2.1.x build. -->
    <PackageReference Include="SQLitePCLRaw.lib.e_sqlite3" Version="3.53.3" />
  </ItemGroup>

  <PropertyGroup>
    <!-- Windows App SDK files the app never loads: push notifications, background tasks, restarting, the bootstrapper
         that only framework-dependent apps need, WebView2, Visual Studio's designer support and the map control's page.
         The three .pri files are already merged into iscWBS.pri. QuestPDF only needs qpdf for merging or encrypting PDFs,
         and its Lato fonts only as a fallback the report never uses. -->
    <UnusedPublishFiles>
      ;PushNotificationsLongRunningTask.ProxyStub.dll;Microsoft.Windows.ApplicationModel.Background.UniversalBGTask.dll;
      ;RestartAgent.exe;Microsoft.WindowsAppRuntime.Bootstrap.dll;Microsoft.Web.WebView2.Core.dll;WebView2Loader.dll;
      ;Microsoft.UI.Designer.dll;map.html;
      ;Microsoft.UI.Xaml.Controls.pri;Microsoft.UI.pri;Microsoft.WindowsAppRuntime.pri;
      ;qpdf.dll;QuestPDF.Fonts.Lato.br;
    </UnusedPublishFiles>
  </PropertyGroup>

  <Target Name="LeaveOutUnusedFiles" AfterTargets="ComputeResolvedFilesToPublishList">
    <ItemGroup>
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)"
                             Condition="$([System.String]::Copy('$(UnusedPublishFiles)').Contains(';%(Filename)%(Extension);'))" />
      <!-- WinRT type descriptions, which native code has compiled in -->
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)" Condition="'%(Extension)' == '.winmd'" />
      <!-- WinUI's own text in 85 other languages, a folder each. The app is in English and Swedish; Windows falls back to en-us. -->
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)"
                             Condition="'%(Extension)' == '.mui' And !$([System.String]::Copy('%(RelativePath)').StartsWith('en-us')) And !$([System.String]::Copy('%(RelativePath)').StartsWith('sv-SE'))" />
    </ItemGroup>
  </Target>
</Project>
