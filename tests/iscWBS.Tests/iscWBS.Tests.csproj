<Project Sdk="Microsoft.NET.Sdk">
  <!-- Core sources are linked rather than referencing the WinUI WinExe, so the tests run on plain
       net10.0 without the Windows App SDK. UI-bound services are deliberately left out. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\..\Core\Exceptions\*.cs" LinkBase="Linked\Exceptions" />
    <Compile Include="..\..\Core\Data\*.cs" LinkBase="Linked\Data" />
    <Compile Include="..\..\Core\Models\*.cs" LinkBase="Linked\Models" />
    <Compile Include="..\..\Core\Services\WbsService.cs;..\..\Core\Services\MilestoneService.cs;..\..\Core\Services\ProjectStateService.cs;..\..\Core\Services\SettingsService.cs;..\..\Core\Services\UpdateService.cs;..\..\Core\Services\ProjectHistory.cs;..\..\Core\Services\BackupService.cs;..\..\Core\Services\RiskService.cs;..\..\Core\Services\ProjectWorkbook.cs;..\..\Core\Services\ProjectContent.cs" LinkBase="Linked\Services" />
    <Compile Include="..\..\Helpers\SettingsKeys.cs" LinkBase="Linked\Helpers" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <None Include="Fixtures\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
    <PackageReference Include="xunit.v3" Version="4.0.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.1" />
    <PackageReference Include="DocumentFormat.OpenXml" Version="3.5.1" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.14" />
    <PackageReference Include="SQLitePCLRaw.lib.e_sqlite3" Version="3.53.3" />
  </ItemGroup>
</Project>
